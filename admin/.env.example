# Copy this file to .env and fill in the values you want. .env is gitignored
# and loaded automatically on startup (see loadEnv.js) — real environment
# variables you've exported yourself still take priority over this file.

# Login
OPSKEEP_ADMIN_USERNAME=owner
OPSKEEP_ADMIN_PASSWORD=

# Encrypts saved provider API keys at rest. Required (24+ characters) before
# you can save a key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OPSKEEP_KEY_ENCRYPTION_SECRET=

# Signs session cookies. Set a fixed value if you want sessions to survive a
# server restart; otherwise a random one is generated each boot.
OPSKEEP_ADMIN_SECRET=

# OPSKEEP_ADMIN_PORT=8377
# OPSKEEP_ADMIN_HOST=127.0.0.1
# OPSKEEP_STORE_FILE=
# OPSKEEP_AGENT_RUNNER=
