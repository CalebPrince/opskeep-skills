  "rules": [
    {
      "id": "r01",
      "area": "ux",
      "when": {
        "u_frequency": [
          "daily",
          "allday"
        ]
      },
      "say": "Used daily: persistent navigation, keyboard shortcuts and fast repeated actions matter more than first-impression polish."
    },
    {
      "id": "r02",
      "area": "ux",
      "when": {
        "u_frequency": [
          "occasional"
        ]
      },
      "say": "Used occasionally: screens must explain themselves. Guidance beats speed."
    },
    {
      "id": "r03",
      "area": "ux",
      "when": {
        "u_activity": [
          "managing",
          "searching"
        ]
      },
      "say": "Records-heavy work: tables, filters and saved views become first-class."
    },
    {
      "id": "r04",
      "area": "ux",
      "when": {
        "u_activity": [
          "monitoring"
        ]
      },
      "say": "Monitoring: glanceable status, alerts and data-freshness indicators."
    },
    {
      "id": "r05",
      "area": "ux",
      "when": {
        "u_activity": [
          "creating"
        ]
      },
      "say": "Creation flows need autosave, undo and strong empty states."
    },
    {
      "id": "r06",
      "area": "ux",
      "when": {
        "u_skill": [
          "expert"
        ]
      },
      "say": "Power users: density and shortcuts over hand-holding."
    },
    {
      "id": "r07",
      "area": "ux",
      "when": {
        "u_skill": [
          "novice"
        ]
      },
      "say": "First-timers: guided onboarding, plain language, fewer options per screen."
    },
    {
      "id": "r08",
      "area": "responsive",
      "when": {
        "u_context": [
          "lowband"
        ]
      },
      "say": "Slow connections: lean pages, skeleton loading and offline-tolerant error states."
    },
    {
      "id": "r09",
      "area": "responsive",
      "when": {
        "u_context": [
          "moving",
          "field"
        ]
      },
      "say": "Used away from a desk: large touch targets, high contrast, quick actions."
    },
    {
      "id": "r10",
      "area": "accessibility",
      "when": {
        "u_context": [
          "shared"
        ]
      },
      "say": "Shared screens: larger type and stronger contrast."
    },
    {
      "id": "r11",
      "area": "ux",
      "when": {
        "x_stakes": [
          "high"
        ]
      },
      "say": "High stakes: confirm destructive actions, keep an audit trail, make undo obvious."
    },
    {
      "id": "r12",
      "area": "ux",
      "when": {
        "x_stakes": [
