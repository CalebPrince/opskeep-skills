        {
          "value": "trustworthy",
          "label": "Trustworthy"
        },
        {
          "value": "premium",
          "label": "Premium"
        },
        {
          "value": "fast",
          "label": "Fast"
        },
        {
          "value": "technical",
          "label": "Technical"
        },
        {
          "value": "friendly",
          "label": "Friendly"
        },
        {
          "value": "bold",
          "label": "Bold"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        }
      ]
