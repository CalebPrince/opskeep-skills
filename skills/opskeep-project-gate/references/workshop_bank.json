    {
      "id": "x_tone",
      "section": "experience",
      "type": "dials",
      "prompt": "Nudge the dials. Leave any you don't care about.",
      "why": "Position matters more than precision. Untouched dials mean no opinion.",
      "items": [
        {
          "id": "d_playful",
          "left": "Professional",
          "right": "Playful"
        },
        {
          "id": "d_expressive",
          "left": "Quiet",
          "right": "Expressive"
        },
        {
          "id": "d_spacious",
          "left": "Dense",
          "right": "Spacious"
        },
        {
          "id": "d_distinct",
          "left": "Familiar",
          "right": "Distinctive"
        }
      ]
    },
    {
      "id": "x_stakes",
      "section": "experience",
      "type": "stops",
      "prompt": "When someone makes a mistake, how bad is it?",
      "why": "Drives confirmations, undo, audit trails and how destructive actions look.",
      "options": [
        {
          "value": "low",
          "label": "Easy to undo"
        },
        {
          "value": "mod",
          "label": "Annoying to fix"
        },
        {
          "value": "high",
          "label": "Costly: money, data or safety"
        }
      ]
    },
    {
      "id": "x_mobile",
      "section": "experience",
      "type": "cards",
      "prompt": "On a phone, what should people be able to do?",
      "show_if": {
        "p_platform": [
