{
  "sections": [
    {
      "id": "strategy",
      "label": "The problem",
      "blurb": "What is in the way? Start there, not with what to build."
    },
    {
      "id": "project",
      "label": "Project",
      "blurb": "What are we making?"
    },
    {
      "id": "users",
      "label": "People",
      "blurb": "Who is it for, and how do they work?"
    },
    {
      "id": "experience",
      "label": "Experience",
      "blurb": "How should it feel to use?"
    },
    {
      "id": "visual",
      "label": "Look & feel",
      "blurb": "Point at what feels right."
    }
  ],
  "controls": [
    {
      "id": "s_constraint",
      "section": "strategy",
      "type": "text",
      "multiline": true,
      "required": true,
      "prompt": "What is in the way of the outcome you want?",
      "why": "A constraint is the weak link, not the thing to build. \"Build a client portal\" is a solution; \"clients cannot see invoice status without emailing us\" is a constraint.",
      "placeholder": "e.g. Prospects cannot reach us after hours, so enquiries are lost."
    },
    {
      "id": "s_evidence",
      "section": "strategy",
      "type": "text",
      "multiline": true,
      "optional": true,
      "prompt": "How do you know? What shows it is the constraint?",
      "placeholder": "Numbers, an incident, customer comments, a contract requirement."
    },
    {
      "id": "s_push",
      "section": "strategy",
      "type": "text",
      "optional": true,
      "prompt": "Push: what pain makes people want a change?",
      "placeholder": "What is wrong with how it works today."
    },
    {
      "id": "s_pull",
      "section": "strategy",
      "type": "text",
      "optional": true,
      "prompt": "Pull: what makes the new thing attractive to them?",
      "placeholder": "What would they gain."
    },
    {
      "id": "s_anxiety",
      "section": "strategy",
      "type": "text",
      "optional": true,
      "prompt": "Anxiety: what would make them hesitate or refuse?",
      "why": "Trust, cost, switching effort, handing over data. This is usually where security and privacy decisions come from.",
      "placeholder": "e.g. Worried their details will be shared or spammed."
    },
    {
      "id": "s_habit",
      "section": "strategy",
      "type": "text",
      "optional": true,
      "prompt": "Habit: what do they do today instead?",
      "placeholder": "The current way, even if it is a workaround."
    },
    {
      "id": "s_existing",
      "section": "strategy",
      "type": "text",
      "multiline": true,
      "optional": true,
      "prompt": "What already works or already exists?",
      "why": "More of what works, then better, and only then something new. Existing tools, platform features, earlier work.",
      "placeholder": "Write none if there is nothing."
    },
    {
      "id": "s_belief",
      "section": "strategy",
      "type": "text",
      "multiline": true,
      "prompt": "We believe ...",
      "why": "Your bet starts with what you believe is true about the people or the market.",
      "placeholder": "e.g. visitors will use a short form if it says what happens to their details."
    },
    {
      "id": "s_wager",
      "section": "strategy",
      "type": "segment",
      "prompt": "How big is the bet?",
      "why": "What you are willing to spend to find out. It sizes the scope.",
      "options": [
        {
          "value": "days",
          "label": "A few days"
        },
        {
          "value": "weeks",
          "label": "A few weeks"
        },
        {
          "value": "months",
          "label": "Months"
        }
      ]
    },
    {
      "id": "s_outcome",
      "section": "strategy",
      "type": "text",
      "multiline": true,
      "prompt": "... and this produces what outcome?",
      "why": "An outcome is what changes for the business or the people, not what gets built.",
      "placeholder": "e.g. More qualified enquiries each month, acknowledged within a minute."
    },
    {
      "id": "s_indicator",
      "section": "strategy",
      "type": "chips",
      "max": 3,
      "prompt": "What will you watch to know it is working?",
      "why": "The leading indicator. Pick up to three.",
      "options": [
        {
          "value": "conversion",
          "label": "Conversion rate"
        },
        {
          "value": "signups",
          "label": "Sign-ups or enquiries"
        },
        {
          "value": "time_saved",
          "label": "Time saved"
        },
        {
          "value": "revenue",
          "label": "Revenue"
        },
        {
          "value": "retention",
          "label": "Retention or repeat use"
        },
        {
          "value": "support",
          "label": "Fewer support requests"
        },
        {
          "value": "errors",
          "label": "Fewer errors or incidents"
        },
        {
          "value": "satisfaction",
          "label": "User satisfaction"
        }
      ]
    },
    {
      "id": "p_name",
      "section": "project",
      "type": "text",
      "prompt": "Project name",
      "placeholder": "e.g. LeadFlow",
      "required": true
    },
    {
      "id": "p_summary",
      "section": "project",
      "type": "text",
      "multiline": true,
      "optional": true,
      "prompt": "What does it do, in a sentence or two?",
      "placeholder": "An internal app my sales team uses to track and follow up leads."
    },
    {
      "id": "p_type",
      "section": "project",
      "type": "cards",
      "prompt": "What kind of thing is it?",
      "why": "The product type sets the baseline for navigation, density and page structure.",
      "options": [
        {
          "value": "saas",
          "label": "Web app / SaaS",
          "hint": "Log in, do work"
        },
        {
          "value": "dashboard",
          "label": "Dashboard",
          "hint": "Metrics and monitoring"
        },
        {
          "value": "website",
          "label": "Marketing site",
          "hint": "Explain and convert"
        },
        {
          "value": "ecommerce",
          "label": "Online store",
          "hint": "Browse and buy"
        },
        {
          "value": "mobile",
          "label": "Mobile app",
          "hint": "Phone first"
        },
        {
          "value": "internal",
          "label": "Internal tool",
          "hint": "For a team"
        },
        {
          "value": "other",
          "label": "Something else",
          "hint": ""
        }
      ]
    },
    {
      "id": "p_platform",
      "section": "project",
      "type": "segment",
      "prompt": "Where will people mostly use it?",
      "options": [
        {
          "value": "desktop",
          "label": "Desktop browser"
        },
        {
          "value": "phone",
          "label": "Phone browser"
        },
        {
          "value": "native",
          "label": "Native app"
        },
        {
          "value": "both",
          "label": "Desktop and phone"
        }
      ]
    },
    {
      "id": "p_stage",
      "section": "project",
      "type": "segment",
      "prompt": "Is this new, or replacing something?",
      "options": [
        {
          "value": "new",
          "label": "Brand new"
        },
        {
          "value": "redesign",
          "label": "Redesign"
        },
        {
          "value": "prototype",
          "label": "Quick prototype"
        }
      ]
    },
    {
      "id": "u_frequency",
      "section": "users",
      "type": "stops",
      "prompt": "How often will a typical person use it?",
      "why": "Frequency is the biggest driver of density, shortcuts and navigation depth.",
      "options": [
        {
          "value": "occasional",
          "label": "Occasionally"
        },
        {
          "value": "weekly",
          "label": "Weekly"
        },
        {
          "value": "daily",
          "label": "Daily"
        },
        {
          "value": "allday",
          "label": "All day"
        }
      ]
    },
    {
      "id": "u_activity",
      "section": "users",
      "type": "chips",
      "max": 3,
      "prompt": "What will they spend most of their time doing?",
      "why": "Pick up to three. This decides whether tables, editors, feeds or charts lead the UI.",
      "options": [
        {
          "value": "reading",
          "label": "Reading"
        },
        {
          "value": "searching",
          "label": "Searching"
        },
        {
          "value": "creating",
          "label": "Creating"
        },
        {
          "value": "monitoring",
          "label": "Monitoring"
        },
        {
          "value": "managing",
          "label": "Managing records"
        },
        {
          "value": "communicating",
          "label": "Communicating"
        }
      ]
    },
    {
      "id": "u_skill",
      "section": "users",
      "type": "stops",
      "prompt": "How comfortable are they with software like this?",
      "options": [
        {
          "value": "novice",
          "label": "First-timers"
        },
        {
          "value": "mixed",
          "label": "Mixed"
        },
        {
          "value": "expert",
          "label": "Power users"
        }
      ]
    },
    {
      "id": "u_context",
      "section": "users",
      "type": "chips",
      "prompt": "Where and how do they use it?",
      "options": [
        {
          "value": "desk",
          "label": "At a desk"
        },
        {
          "value": "moving",
          "label": "On the move"
        },
        {
          "value": "field",
          "label": "In the field"
        },
        {
          "value": "shared",
          "label": "On a shared screen"
        },
        {
          "value": "lowband",
          "label": "Slow or patchy internet"
        }
      ]
    },
    {
      "id": "x_feel",
      "section": "experience",
      "type": "chips",
      "max": 3,
      "prompt": "Pick up to three words for how it should feel.",
